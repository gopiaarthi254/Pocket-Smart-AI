# Copy this file to ".env" and fill in your values.
# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=paste_your_gemini_api_key_here

# Gemini model. The project doc says "Gemini 1.5 Flash", but Google has retired
# the 1.5 models, so the current Flash model is used. Change it here if needed.
GEMINI_MODEL=gemini-2.5-flash

# Any long random string (used to sign login tokens)
SECRET_KEY=pocketsmart_change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
